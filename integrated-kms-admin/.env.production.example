# Integrated KMS Admin - production env (PM2가 ecosystem.config.cjs에서 로드)
# 실제 값은 .env.production 으로 복사해 채운다 (.env.production 은 git 미추적).
#   cp .env.production.example .env.production  &&  vi .env.production
#
# 운영 모드(KMS_ADMIN_ENV=production) 시작 시 시크릿 길이 검증:
#   - KMS_ADMIN_JWT_SECRET     : 32자 이상, 개발 기본값 금지
#   - ADMIN_PASSWORD_PEPPER    : 16자 이상
#   - KMS_ADMIN_API_KEY_PEPPER : 16자 이상
#   - ADMIN_BOOTSTRAP_PASSWORD : 12자 이상, 'admin123' 금지

KMS_ADMIN_ENV=production

# LightRAG 본서버 주소. 어드민 포트는 이 포트 + 100 으로 자동 결정 (9621 -> 9721).
LIGHTRAG_BASE_URL=http://127.0.0.1:9621

# 공유 lightrag DB (기본 DSN의 user/pw 가 postgres/postgres 라 반드시 지정 필요)
KMS_ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/lightrag

KMS_ADMIN_JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters
ADMIN_PASSWORD_PEPPER=change-me-min-16-chars
KMS_ADMIN_API_KEY_PEPPER=change-me-min-16-chars
ADMIN_BOOTSTRAP_ID=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-min-12-chars
